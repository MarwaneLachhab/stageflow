# ---------------------------------------------------------------------------
# StageFlow — environment variables
#
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local`. It is already listed in .gitignore.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------
# Project URL. Found under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. SAFE to expose: every table is protected by Row Level
# Security, so this key grants no access beyond what a signed-in user may see.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Supabase — SECRET. Server-side only.
# ---------------------------------------------------------------------------
# ⚠️  DO NOT prefix this with NEXT_PUBLIC_.
#
# Next.js inlines every NEXT_PUBLIC_* variable into the JavaScript sent to the
# browser. A prefixed service-role key would be published to every visitor and
# would bypass Row Level Security entirely — dismantling every access control
# in the application at once.
#
# This key is read through `serverEnv` in lib/env.ts, which refuses to evaluate
# in a browser context.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# The public origin. Used to build authentication redirect links.
# Must match the deployed origin exactly: no trailing slash.
# Add `${NEXT_PUBLIC_SITE_URL}/auth/callback` to Supabase → Authentication →
# URL Configuration → Redirect URLs, or confirmation e-mails will break.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email OTP delivery
# ---------------------------------------------------------------------------
# Signup confirmation codes are sent by Supabase Auth. For a real deployment,
# configure SMTP in Supabase Dashboard → Authentication → SMTP Settings (or in
# supabase/config.toml for a self-hosted instance), enable email confirmations,
# and add the exact site URL plus /auth/callback to the redirect allow-list.
# The app never logs or stores the OTP.

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Transactional e-mail notifications. Read by `serverEnv.enableEmailNotifications`
# in lib/env.ts. Leave unset/false unless an e-mail provider is actually wired up:
# enabling it without a provider would silently swallow notifications.
# ENABLE_EMAIL_NOTIFICATIONS=false

# ---------------------------------------------------------------------------
# Demo seed — NOT an environment variable
# ---------------------------------------------------------------------------
# supabase/migrations/9999_dev_seed.sql is gated by a POSTGRES setting, not by an
# environment variable. The previous `STAGEFLOW_SEED_DEMO` key shown here was
# dead: no application code ever read it. To enable the fixtures, run this in the
# SQL editor of a DEVELOPMENT database only:
#
#   alter database postgres set "stageflow.seed_demo" = 'on';
#   -- then re-run 9999_dev_seed.sql
#
# To disable again:
#
#   alter database postgres reset "stageflow.seed_demo";
#
# The seed creates seven fictional applicants. It NEVER creates an administrator,
# because a demo admin account with a known password would be a back door.

